rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 玩家資料：任何從網頁進來（已匿名登入）的人都能看、能改，但不能刪除
    function validPlayer(d) {
      return d.keys().hasOnly(['name', 'counts', 'ever', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.counts is map && d.counts.size() <= 200
        && d.ever is map && d.ever.size() <= 200;
    }

    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && validPlayer(request.resource.data);
      allow delete: if false;
    }

    // 交換紀錄：可以新增；之後只能把它標記為「已復原」，不能刪除或竄改內容
    match /logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'to', 'card', 'at', 'newUnlock', 'undone', 'fromName', 'toName'])
        && request.resource.data.card is int
        && request.resource.data.undone == false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['undone', 'undoneAt'])
        && request.resource.data.undone == true;
      allow delete: if false;
    }
  }
}
